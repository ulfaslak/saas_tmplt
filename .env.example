# Local dev environment. Copy to `.env` and fill in.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# App identity (used in email From header and template branding)
APP_NAME=App
EMAIL_FROM_ADDRESS="App <noreply@example.com>"

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Auth providers (only those with values configured will be available on the
# login page — leave the rest unset).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=

# Public URL — used in outbound invite emails. For local OAuth callbacks,
# point your provider config at http://localhost:5173/auth/callback/<provider>.
# APP_URL=https://abc123.ngrok-free.app
