			"esbuild"
		]
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.1",
		"@auth/sveltekit": "^1.11.1",
		"@sveltejs/adapter-node": "^5.5.3",
		"@tailwindcss/typography": "^0.5.19",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"pg-boss": "^12.14.0",
		"pino": "^10.3.1",
		"postgres": "^3.4.8",
		"resend": "^6.9.4",
		"tailwind-merge": "^3.4.1",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.3.6"
	}
