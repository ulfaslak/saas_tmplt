# Database (must match POSTGRES_* vars in docker-compose.prod.yml)
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app

# Postgres container credentials
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app

# App identity (used in email From header and template branding)
APP_NAME=App
EMAIL_FROM_ADDRESS="App <noreply@example.com>"

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Auth providers (only those with values configured will be available on the
# login page — leave the rest unset).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=

# Public URL (used in invite emails and other outbound links)
APP_URL=https://YOUR_DOMAIN
